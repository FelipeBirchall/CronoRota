# Copie para .env (cp .env.example .env) antes do "docker compose up".
# O docker-compose.yml lê estas variáveis; sem elas o Postgres não sobe.
POSTGRES_DB=cronorota
POSTGRES_USER=cronorota
POSTGRES_PASSWORD=troque-esta-senha

# Mínimo de 32 caracteres (HS256). Gere um com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
